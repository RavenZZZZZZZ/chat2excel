# ==============================================================================
# 生产环境变量
# ==============================================================================
#
# 这些变量在 Vercel 部署时使用
# 敏感信息（API Keys）应通过 Vercel Dashboard 设置，不要提交到 Git
#
# ==============================================================================

# API 配置
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=30000

# OCR 服务配置
VITE_OCR_PROVIDER=doc2x
VITE_DOC2X_PROXY_URL=/api/proxy
VITE_DOC2X_TIMEOUT=60000

# 环境标识
VITE_APP_ENV=production
NODE_ENV=production

# 功能开关
VITE_ENABLE_BETA_FEATURES=false

# ==============================================================================
# 以下变量需要在 Vercel Dashboard 中设置
# ==============================================================================
#
# DOC2X_API_KEY=your-actual-api-key
# DOC2X_API_BASE_URL=https://v2.doc2x.noedgeai.com
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id (可选)
# SENTRY_ENVIRONMENT=production (可选)
#
# ==============================================================================
