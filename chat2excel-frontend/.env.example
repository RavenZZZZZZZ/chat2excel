# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# OCR Service Configuration
VITE_OCR_PROVIDER=doc2x
VITE_DOC2X_API_KEY=sk-your-api-key-here
VITE_DOC2X_PROXY_URL=http://localhost:3001/api/proxy
VITE_DOC2X_TIMEOUT=60000

# Tesseract Configuration (only used if VITE_OCR_PROVIDER=tesseract)
VITE_TESSERACT_WORKER_PATH=/tesseract.js
VITE_TESSERACT_LANG_PATH=/lang/

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET_NAME=ocr-images
VITE_SUPABASE_STORAGE_PATH=uploads

# Export Configuration
VITE_EXPORT_MAX_SIZE_MB=10

# Feature Flags
VITE_ENABLE_BETA_FEATURES=false
VITE_ENABLE_ANALYTICS=false

# Environment
VITE_APP_ENV=development
