# ==============================================================================
# 环境变量配置示例
# ==============================================================================
#
# 复制此文件为 .env.local 并填入实际值
#
# 注意：
# - 前端环境变量必须以 VITE_ 开头
# - 后端环境变量（Vercel）在 Vercel Dashboard 中配置，不要提交到代码库
# - 不要将包含真实密钥的 .env.local 文件提交到 Git
#
# ==============================================================================

# -------------------------------------------------------------------------------
# 前端环境变量 (Vite)
# -------------------------------------------------------------------------------

# API 基础地址
# 开发环境：指向本地 Vite 开发服务器
# 生产环境：使用相对路径 /api（Vercel 自动路由到同域名的 /api）
VITE_API_BASE_URL=http://localhost:3000/api

# Doc2X 代理 URL（可选，用于覆盖默认设置）
VITE_DOC2X_PROXY_URL=/api/ocr
VITE_DOC2X_TIMEOUT=60000

# -------------------------------------------------------------------------------
# 后端环境变量 (Vercel Serverless Functions)
# -------------------------------------------------------------------------------
# 以下环境变量在 Vercel Dashboard → Settings → Environment Variables 中配置

# Supabase (服务端密钥 - 必须使用 SERVICE_ROLE_KEY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_BUCKET_NAME=ocr-images

# Doc2X API
DOC2X_API_KEY=sk-your-doc2x-api-key-here
DOC2X_API_BASE_URL=https://v2.doc2x.noedgeai.com

# CORS (允许的前端域名，用逗号分隔)
ALLOWED_ORIGINS=https://chat2excel.vercel.app,https://your-custom-domain.com

# 文件上传限制
MAX_FILE_SIZE=7242880  # 7MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# 应用配置
NODE_ENV=production
APP_VERSION=1.0.0

# -------------------------------------------------------------------------------
# 已弃用的环境变量（前端不再直接访问 Supabase）
# -------------------------------------------------------------------------------
# VITE_SUPABASE_URL=xxx  # 删除
# VITE_SUPABASE_ANON_KEY=xxx  # 删除
# VITE_SUPABASE_BUCKET_NAME=xxx  # 删除
# VITE_SUPABASE_STORAGE_PATH=xxx  # 删除
