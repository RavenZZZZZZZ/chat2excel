#!/bin/bash
# ==============================================================================
# diagnose-storage.sh - 诊断 Supabase Storage 配置问题
# ==============================================================================

echo "🔍 Supabase Storage 诊断工具"
echo "========================================"
echo ""
echo "本脚本帮助你诊断 Supabase Storage 配置问题"
echo ""

# 检查清单
echo "📋 检查清单："
echo ""

echo "1. ✅ 环境变量已配置（已在 Vercel 中设置）"
echo "   - SUPABASE_URL"
echo "   - SUPABASE_SERVICE_ROLE_KEY"
echo "   - SUPABASE_BUCKET_NAME"
echo ""

echo "2. 🪣 Supabase Storage Bucket"
echo "   请在 Supabase Dashboard 中检查："
echo "   - 访问：https://supabase.com/dashboard"
echo "   - 选择你的项目"
echo "   - 点击左侧 'Storage' 菜单"
echo "   - 确认是否有名为 'ocr-images' 的 bucket"
echo ""

echo "3. 🔧 如果 bucket 不存在，请执行以下步骤："
echo "   方法 1: 使用 Supabase Dashboard（推荐）"
echo "   - 在 Storage 页面点击 'Create a new bucket'"
echo "   - Name: ocr-images"
echo "   - Public bucket: ✅ (勾选)"
echo "   - 点击 'Create bucket'"
echo ""
echo "   方法 2: 使用 SQL 脚本"
echo "   - 在 Supabase Dashboard → SQL Editor 中运行:"
echo "   - 执行: scripts/init-supabase-storage.sql"
echo ""

echo "4. 📊 数据库表检查"
echo "   确认以下表存在:"
echo "   - ocr_tasks (存储 OCR 任务)"
echo "   - 如果不存在，执行 scripts/init-supabase-storage.sql"
echo ""

echo "5. 🔐 权限检查"
echo "   确认使用的是 SERVICE_ROLE_KEY (不是 ANON_KEY)"
echo "   - SERVICE_ROLE_KEY 可以绕过 RLS"
echo "   - 拥有完全访问权限"
echo ""

echo "6. 🧪 测试上传功能"
echo "   可以使用以下方法测试："
echo ""
echo "   方法 1: 使用 curl (需要你的环境变量)"
echo "   ```bash"
echo "   curl -X POST https://yiruo.chat/api/storage/upload \\"
echo "     -F 'file=@test.jpg'"
echo "   ```"
echo ""
echo "   方法 2: 直接在前端测试"
echo "   - 访问 https://yiruo.chat"
echo "   - 上传一张图片"
echo "   - 查看浏览器控制台的错误信息"
echo ""

echo "7. 📝 查看详细错误日志"
echo "   在 Vercel Dashboard 中："
echo "   - 访问：https://vercel.com/dashboard"
echo "   - 选择你的项目"
echo "   - 点击 'Deployments' → 选择最新部署"
echo "   - 点击 'Functions' → 'api/storage/upload'"
echo "   - 查看 'Logs' 标签页中的错误信息"
echo ""

echo "========================================"
echo "💡 最常见的问题和解决方案："
echo ""
echo "问题 1: Bucket 不存在"
echo "解决: 创建 bucket（见步骤 3）"
echo ""
echo "问题 2: 权限不足"
echo "解决: 确认使用 SERVICE_ROLE_KEY"
echo ""
echo "问题 3: 环境变量未正确配置"
echo "解决: 在 Vercel Dashboard 中重新配置并重新部署"
echo ""
echo "问题 4: RLS 策略阻止访问"
echo "解决: 使用 SERVICE_ROLE_KEY 可以绕过 RLS"
echo "========================================"
